{
  "name": "opencode-fork-tree",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin: browse session forks as a tree, jump between branches, and fork any user message",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "fork",
    "tree",
    "sidebar",
    "session"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "opencode": ">=2.4.0"
  },
  "exports": {
    "./tui": "./tui.tsx"
  },
  "files": [
    "tui.tsx",
    "tree.ts",
    "messages.ts",
    "restore.ts",
    "format.ts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susususutie/opencode-fork-tree.git"
  },
  "homepage": "https://github.com/susususutie/opencode-fork-tree#readme",
  "bugs": {
    "url": "https://github.com/susususutie/opencode-fork-tree/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.9.2",
    "@opentui/solid": ">=0.9.2",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/bun": "1.4.3",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
